# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg
*.egg-info/
dist/
build/
*.whl

# Virtual environments
.venv/
.venv*/
venv/
env/
ENV/

# Coverage
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Jupyter
.ipynb_checkpoints/
*.ipynb_metadata

# Datasets and large files (use DVC or document sources in datasets/README.md)
!datasets/train_split.csv
!datasets/test_split.csv
datasets/**/*.parquet
datasets/**/*.h5
datasets/**/*.hdf5
datasets/**/*.pkl
datasets/**/*.npy
datasets/**/*.npz
datasets/**/*.zip
datasets/**/*.tar.gz
datasets/**/*.pcap

# Model checkpoints / serialized artifacts (audit C1: do not commit binaries;
# they are non-portable across numpy/sklearn versions and violate repo policy)
*.pt
*.pth
*.onnx
*.bin
*.pkl
*.joblib
# (model binaries above are ignored; experiments/models/artifact_manifest.json
#  is a small JSON provenance record and IS tracked — do not ignore the dir)
checkpoints/
models/weights/

# Logs
logs/
*.log
*.out

# Secrets and credentials — NEVER commit these
.env
.env.*
secrets/
credentials/
*.key
*.pem
*.cert

# Results that can be reproduced
experiments/results/*.png
experiments/results/*.pdf

!datasets/train_split.csv
!datasets/test_split.csv

datasets/train_split.csv
datasets/test_split.csv

# RANA training data: regenerable via scripts/fetch_data.py (provenance JSON IS committed)
datasets/rana_train.csv
# RANA multilingual augmentation: regenerable via scripts/augment_multilingual.py
datasets/rana_multilingual_aug.csv
